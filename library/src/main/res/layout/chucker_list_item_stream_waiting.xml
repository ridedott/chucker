<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/chucker_doub_grid"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/time"
        android:layout_width="@dimen/chucker_octa_grid"
        android:layout_height="wrap_content"
        android:textColor="@color/chucker_status_live"
        android:textSize="13sp"
        android:typeface="monospace"
        tools:text="+12.4 s" />

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/chucker_base_grid">

        <ImageView
            android:id="@+id/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/chucker_live_dot" />
    </FrameLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="@string/chucker_grpc_waiting"
        android:textColor="@color/chucker_status_live"
        android:textSize="14sp" />
</LinearLayout>
